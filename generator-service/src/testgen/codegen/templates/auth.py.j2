def atlas_login_value(name):
    """Read one credential value from the environment."""
    value = os.environ.get(name)
    if value is None:
        raise SystemExit(
            f"Missing environment variable {name}. Set it before running this script."
        )
    return value


def atlas_login_field(driver, strategy, target):
    """Find one credential field, using the same selector rules as the generator."""
    from selenium.common.exceptions import NoSuchElementException

    if strategy == "name_or_id":
        for by in (By.NAME, By.ID):
            try:
                return driver.find_element(by, target)
            except NoSuchElementException:
                continue
        raise SystemExit(f"Login field not found: {target}")

    strategies = {
        "id": By.ID,
        "name": By.NAME,
        "css": By.CSS_SELECTOR,
        "xpath": By.XPATH,
    }
    return driver.find_element(strategies[strategy], target)


