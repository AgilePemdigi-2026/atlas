# --- Auth Profile (ATLAS) ---
# This script logs in inside each scenario. The credential values are
# never stored in the script: set these environment variables before running it.
{{ credential_docs }}

LOGIN_TIMEOUT = 10


def atlas_login_value(name):
    """Read one credential value from the environment."""
    value = os.environ.get(name)
    if value is None:
        raise SystemExit(
            f"Missing environment variable {name}. Set it before running this script."
        )
    return value


def atlas_login_field(driver, strategy, target):
    """Wait explicitly for one credential field to become visible."""
    from selenium.webdriver.support import expected_conditions as EC

    strategies = {
        "id": By.ID,
        "name": By.NAME,
        "css": By.CSS_SELECTOR,
        "xpath": By.XPATH,
    }
    if strategy == "name_or_id":
        for by in (By.NAME, By.ID):
            try:
                return WebDriverWait(driver, LOGIN_TIMEOUT).until(
                    EC.visibility_of_element_located((by, target))
                )
            except Exception:
                continue
        raise SystemExit(f"Login field not found: {target}")
    return WebDriverWait(driver, LOGIN_TIMEOUT).until(
        EC.visibility_of_element_located((strategies[strategy], target))
    )


def atlas_login_submit(driver):
    """Click the configured submit button, falling back to Enter."""
    from selenium.webdriver.common.keys import Keys
    from selenium.webdriver.support import expected_conditions as EC

    submit_strategy = {{ submit_strategy }}
    submit_target = {{ submit_target }}
    strategies = {
        "id": By.ID,
        "name": By.NAME,
        "css": By.CSS_SELECTOR,
        "xpath": By.XPATH,
    }
    if submit_strategy is not None:
        try:
            button = WebDriverWait(driver, LOGIN_TIMEOUT).until(
                EC.element_to_be_clickable((strategies[submit_strategy], submit_target))
            )
            button.click()
            return None
        except Exception:
            raise SystemExit(f"Submit button not found: {submit_target}")
    return Keys.ENTER


